POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_support_agent

# Port 5433, not 5432 — see backend/docker-compose.yaml.
#
# Two roles, on purpose. Postgres exempts superusers and a table's owner from
# row-level security, so an application connecting as `postgres` would pass
# straight through every tenant policy. The app connects as a non-owning role
# created by the RLS migration; migrations keep using the owner.
DATABASE_URL=postgresql+psycopg://supportmind_app:supportmind_app@localhost:5433/rag_support_agent
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/rag_support_agent
APP_DB_ROLE=supportmind_app
APP_DB_PASSWORD=supportmind_app
# CORS. Comma-separated if there is more than one — a Render preview URL
# alongside a custom domain, for example. Required (the app refuses to start
# without it) once APP_ENV is anything other than local/development/dev.
#   FRONTEND_ORIGIN=https://your-frontend.onrender.com
APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000

# Logging. JSON wherever logs are shipped somewhere and queried; plain text on
# a laptop where a human reads them directly.
LOG_LEVEL=INFO
LOG_JSON=true
# Error reporting is wired but off. Set a DSN and install sentry-sdk to enable
# it; nothing here needs an account to exist.
SENTRY_DSN=

# Job queue. Document preparation is enqueued here and run by worker.py.
REDIS_URL=redis://localhost:6379/0


JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh tokens are revocable and rotate on every use, so they can be long.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate limiting, counted in Redis. Auth is limited per client address,
# chat per organization — chat is the OpenAI spend path.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_MAX_REQUESTS=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# The daily half of the spending controls. Rate limiting bounds a burst; this
# bounds a day. Counted in tokens because that is what the provider reports.
# Zero means no budget configured, not zero tokens allowed.
DAILY_BUDGET_ENABLED=true
DAILY_TOKEN_BUDGET=1000000


# Storage. `local` writes below UPLOAD_DIR. Deployments should use `s3` with a
# private S3-compatible bucket (the Render guide uses Supabase Storage).
STORAGE_BACKEND=local
UPLOAD_DIR=storage/uploads
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=uploads
MAX_UPLOAD_SIZE_MB=10
# Leave false so the prepare endpoint owns extraction and indexing as one step.
AUTO_INGEST_ON_UPLOAD=false
CHUNK_SIZE=1200
CHUNK_OVERLAP=200


OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
INDEX_BATCH_SIZE=50


CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.2
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
