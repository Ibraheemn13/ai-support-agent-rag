# Public DNS names. Create A records for both before starting Caddy.
APP_DOMAIN=supportmind.example.com
API_DOMAIN=api.supportmind.example.com
ACME_EMAIL=you@example.com

# Use hex/alphanumeric secrets so they can be embedded safely in database URLs.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=supportmind
APP_DB_PASSWORD=replace-with-another-openssl-rand-hex-24
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32

OPENAI_API_KEY=replace-with-your-openai-api-key
DAILY_TOKEN_BUDGET=1000000
REDIS_MAXMEMORY=256mb
SENTRY_DSN=
